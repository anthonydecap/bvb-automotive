# Public URL of the site, used for canonical and Open Graph URLs.
NEXT_PUBLIC_SITE_URL=https://bvbautomotive.be

# Optional: point the site at another Prismic repository.
# NEXT_PUBLIC_PRISMIC_ENVIRONMENT=bvb-automotive

# Contact form: messages are sent through Resend (https://resend.com).
# RESEND_API_KEY=
# CONTACT_EMAIL_TO=info@bvbautomotive.be
# CONTACT_EMAIL_FROM="BVB Automotive <website@bvbautomotive.be>"

# Only needed for `npm run push:models` and `npm run seed:prismic`. Never commit this value.
# PRISMIC_WRITE_TOKEN=
