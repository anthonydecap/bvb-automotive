{
  "id": "car_grid",
  "type": "SharedSlice",
  "name": "Wagens",
  "description": "Overzicht van wagens uit het aanbod",
  "variations": [
    {
      "id": "default",
      "name": "Standaard",
      "docURL": "...",
      "version": "initial",
      "description": "Overzicht van wagens uit het aanbod",
      "imageUrl": "",
      "primary": {
        "eyebrow": {
          "type": "Text",
          "config": {
            "label": "Bovenschrift",
            "placeholder": "Kort label boven de titel"
          }
        },
        "title": {
          "type": "StructuredText",
          "config": {
            "label": "Titel",
            "placeholder": "Gebruik cursief voor het goudkleurige accent",
            "allowTargetBlank": false,
            "single": "heading2,strong,em"
          }
        },
        "intro": {
          "type": "StructuredText",
          "config": {
            "label": "Intro",
            "placeholder": "",
            "allowTargetBlank": true,
            "multi": "paragraph,strong,em,hyperlink"
          }
        },
        "selection": {
          "type": "Select",
          "config": {
            "label": "Welke wagens",
            "placeholder": "",
            "options": [
              "Volledig aanbod",
              "Uitgelicht",
              "VAG",
              "BMW & Mini",
              "Premium & Performance",
              "Recent verkocht"
            ],
            "default_value": "Volledig aanbod"
          }
        },
        "show_filters": {
          "type": "Boolean",
          "config": {
            "label": "Filters tonen",
            "default_value": false,
            "placeholder_true": "Ja",
            "placeholder_false": "Nee"
          }
        },
        "show_sold": {
          "type": "Boolean",
          "config": {
            "label": "Verkochte wagens tonen",
            "default_value": false,
            "placeholder_true": "Ja",
            "placeholder_false": "Nee"
          }
        },
        "limit": {
          "type": "Number",
          "config": {
            "label": "Maximum aantal",
            "placeholder": "Leeg = alles"
          }
        },
        "button_label": {
          "type": "Text",
          "config": {
            "label": "Knoptekst",
            "placeholder": ""
          }
        },
        "button_link": {
          "type": "Link",
          "config": {
            "label": "Knoplink",
            "placeholder": "",
            "select": null,
            "allowTargetBlank": true,
            "allowText": false,
            "repeat": false
          }
        }
      },
      "items": {}
    }
  ]
}
